rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "Bm2XwQBXXEePFaaMfLs5K5ck0HB2";
    }
    match /characters/{characterId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /updates/{updateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /trafficVisits/{visitId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['uid', 'day', 'page'])
        && request.resource.data.keys().hasAll(['uid', 'day', 'page'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.page in ['home', 'remington']
        && request.resource.data.day is string
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}
      allow read: if settingId == "homepage";
      allow create, update, delete: if isAdmin() && settingId == "homepage";
    }
  }
}
)
        && visitId == request.auth.uid + '_' + request.resource.data.day + '_' + request.resource.data.page;
      allow update, delete: if false;
    }
    match /settings/{settingId} {
      allow read: if settingId == "homepage";
      allow create, update, delete: if isAdmin() && settingId == "homepage";
    }
  }
}
