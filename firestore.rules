rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "Bm2XwQBXXEePFaaMfLs5K5ck0HB2";
    }
    match /characters/{characterId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /updates/{updateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /trafficVisits/{visitId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['uid', 'day', 'page'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.page in ['home', 'remington']
        && request.resource.data.day is string
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && visitId == request.auth.uid + '_' + request.resource.data.day + '_' + request.resource.data.page;
      allow update, delete: if false;
    }
    match /settings/{settingId} {
      allow read: if settingId in ['homepage','site','layout'];
      allow create, update, delete: if isAdmin() && settingId in ['homepage','site','layout'];
    }
    match /members/{memberId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == memberId);
      allow create: if request.auth != null && request.auth.uid == memberId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['username','bio','avatarUrl','createdAt','updatedAt'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 2
        && request.resource.data.username.size() <= 32
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null && request.auth.uid == memberId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['username','bio','avatarUrl','createdAt','updatedAt'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 2
        && request.resource.data.username.size() <= 32
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 500
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
    match /memberFlags/{memberId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == memberId);
      allow write: if isAdmin();
    }
  }
}
