rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "Bm2XwQBXXEePFaaMfLs5K5ck0HB2";
    }
    match /applications/{applicationId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.auth != null
        && applicationId == request.resource.data.businessId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['businessId','applicantUid','name','contact','experience','reason','availability','status','createdAt'])
        && request.resource.data.businessId is string
        && request.resource.data.businessId.size() <= 100
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.contact is string
        && request.resource.data.contact.size() >= 3 && request.resource.data.contact.size() <= 120
        && request.resource.data.experience is string
        && request.resource.data.experience.size() <= 1200
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10 && request.resource.data.reason.size() <= 1200
        && request.resource.data.availability is string
        && request.resource.data.availability.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId))
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.hiringOpen == true;
    }
    match /businesses/{businessId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /characters/{characterId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /updates/{updateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /trafficVisits/{visitId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['uid', 'day', 'page'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.page in ['home', 'remington']
        && request.resource.data.day is string
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && visitId == request.auth.uid + '_' + request.resource.data.day + '_' + request.resource.data.page;
      allow update, delete: if false;
    }
    match /settings/{settingId} {
      allow read: if settingId in ['homepage','site','layout'];
      allow create, update, delete: if isAdmin() && settingId in ['homepage','site','layout'];
    }
    match /members/{memberId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == memberId);
      allow create: if request.auth != null && request.auth.uid == memberId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['username','bio','avatarUrl','cropX','cropY','cropZoom','createdAt','updatedAt'])
        && request.resource.data.get("cropX",50) is number && request.resource.data.get("cropY",50) is number && request.resource.data.get("cropZoom",1) is number
        && request.resource.data.get("cropX",50) >= 0 && request.resource.data.get("cropX",50) <= 100
        && request.resource.data.get("cropY",50) >= 0 && request.resource.data.get("cropY",50) <= 100
        && request.resource.data.get("cropZoom",1) >= 1 && request.resource.data.get("cropZoom",1) <= 2.5
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 2
        && request.resource.data.username.size() <= 32
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null && request.auth.uid == memberId
        && (!exists(/databases/$(database)/documents/memberFlags/$(memberId)) || get(/databases/$(database)/documents/memberFlags/$(memberId)).data.suspended != true)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['username','bio','avatarUrl','cropX','cropY','cropZoom','createdAt','updatedAt'])
        && request.resource.data.get("cropX",50) is number && request.resource.data.get("cropY",50) is number && request.resource.data.get("cropZoom",1) is number
        && request.resource.data.get("cropX",50) >= 0 && request.resource.data.get("cropX",50) <= 100
        && request.resource.data.get("cropY",50) >= 0 && request.resource.data.get("cropY",50) <= 100
        && request.resource.data.get("cropZoom",1) >= 1 && request.resource.data.get("cropZoom",1) <= 2.5
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 2
        && request.resource.data.username.size() <= 32
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 500
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
    match /memberFlags/{memberId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == memberId);
      allow write: if isAdmin();
    }
  }
}
