rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /characters/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "Bm2XwQBXXEePFaaMfLs5K5ck0HB2"
        && userId == request.auth.uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if request.auth != null && request.auth.uid == "Bm2XwQBXXEePFaaMfLs5K5ck0HB2" && userId == request.auth.uid;
    }
  }
}
